DATABASE_URL=postgresql+psycopg2://app:app@db:5432/app
REDIS_URL=redis://redis:6379/0
WORKER_BROKER=redis://redis:6379/0
WORKER_RESULT_BACKEND=redis://redis:6379/1
ENABLE_OPENAI_CLIENT=false
OPENAI_API_KEY=
