DATABASE_URL=postgresql+psycopg2://app:app@db:5432/app
REDIS_URL=redis://redis:6379/0
WORKER_BROKER=redis://redis:6379/0
WORKER_RESULT_BACKEND=redis://redis:6379/1
ENABLE_OPENAI_CLIENT=true
OPENAI_API_KEY=
INPUT_TOKEN_BUDGET=3000
MAX_OUTPUT_TOKENS=512
CONTEXT_WINDOW=4096
RETRIEVAL_TOP_K=12
SUMMARY_INTERVAL=10
SUMMARY_HIGH_UTILIZATION=0.9
SUMMARY_LOW_UTILIZATION=0.7
USE_LLM_SUMMARY=false
SUMMARY_MODEL_NAME=gpt-3.5-turbo
SUMMARY_MAX_OUTPUT_TOKENS=256
SUMMARY_WINDOW_EVENTS=20
ENABLE_SEMANTIC_CACHE=false
SEMANTIC_CACHE_THRESHOLD=0.92
TRACING_ENABLED=true
REDACT_BEFORE_EMBEDDING=true
EMBEDDING_MODEL_NAME=text-embedding-3-small
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACT_ROLES=user
MEMORY_GATE_ENABLED=true
MEMORY_GATE_THRESHOLD=0.55
MEMORY_GATE_TYPE_THRESHOLD=0.45
MEMORY_GATE_PRETRAINED_ENABLED=true
MEMORY_GATE_PRETRAINED_MODEL=all-MiniLM-L6-v2
SPACY_MATCHER_ENABLED=true
LLM_MEMORY_EXTRACTOR_ENABLED=true
LLM_MEMORY_EXTRACTOR_MIN_CONF=0.75
LLM_MEMORY_EXTRACTOR_MAX_CALLS_PER_SESSION_PER_HOUR=10
LLM_MEMORY_EXTRACTOR_MODEL_NAME=mock
