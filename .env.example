MAX_OUTPUT_TOKENS=512
CONTEXT_WINDOW=4096
RETRIEVAL_TOP_K=12
SUMMARY_INTERVAL=10
ENABLE_SEMANTIC_CACHE=false
SEMANTIC_CACHE_THRESHOLD=0.92
TRACING_ENABLED=true
REDACT_BEFORE_EMBEDDING=true
